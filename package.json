{
  "name": "uk-car-finder",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "wrangler dev",
    "dev:web": "vite --config web/vite.config.ts",
    "build": "vite build --config web/vite.config.ts",
    "deploy": "pnpm run build && wrangler deploy",
    "test": "vitest run && vitest run -c vitest.workers.config.ts",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit && tsc --noEmit -p web/tsconfig.json",
    "smoke": "tsx scripts/smoke.ts",
    "db:local": "wrangler d1 execute uk-car-finder --local --file=./migrations/0001_init.sql",
    "db:remote": "wrangler d1 execute uk-car-finder --remote --file=./migrations/0001_init.sql",
    "test:unit": "vitest run",
    "test:integration": "vitest run -c vitest.workers.config.ts",
    "predev": "pnpm run build",
    "capture:fixture": "tsx scripts/capture-fixture.ts"
  },
  "dependencies": {
    "hono": "^4.13.1"
  },
  "devDependencies": {
    "@cloudflare/vitest-pool-workers": "^0.20.3",
    "@cloudflare/workers-types": "^5.20260809.1",
    "@types/node": "^26.2.0",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@vitejs/plugin-react": "^6.0.5",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "tsx": "^4.23.11",
    "typescript": "^7.0.2",
    "vite": "^8.2.1",
    "vitest": "^4.1.10",
    "wrangler": "^4.120.0"
  },
  "packageManager": "pnpm@9.14.2"
}
