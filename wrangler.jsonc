{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "uk-car-finder",
	"main": "src/index.ts",
	"compatibility_date": "2025-01-15",
	"compatibility_flags": [
		"nodejs_compat"
	],
	// Serve only from the custom domain, which sits behind Cloudflare Access.
	// Both of these default to true, so leaving them out means every deploy
	// re-creates a *.workers.dev URL that answers without going through Access.
	// preview_urls matters as much as workers_dev: it publishes
	// <version>-<name>.<subdomain>.workers.dev, which the Access policy on the
	// custom domain does not cover.
	"workers_dev": false,
	"preview_urls": false,
	// No `routes` key on purpose: wrangler overrides dashboard-configured
	// routes with whatever the config declares, and omitting it leaves the
	// custom domain set up in the dashboard alone. Crons mean routes are not
	// required here.
	"assets": {
		"directory": "./web/dist",
		"binding": "ASSETS",
		"not_found_handling": "single-page-application"
	},
	// The binding is DB, not the database name — `wrangler d1 create`
	// rewrites this file and will try to rename it. src/index.ts reads env.DB.
	"d1_databases": [
		{
			"binding": "DB",
			"database_name": "uk-car-finder",
			"database_id": "e9c91e3d-8244-4a34-931a-ef6e0aee5d23",
			"migrations_dir": "migrations"
		}
	],
	"triggers": {
		"crons": [
			// Refresh every saved search.
			"0 */4 * * *",
			// Drain the detail-fetch queue (free plan allows only 50 subrequests
			// per invocation, so detail pages are fetched in small batches).
			"*/15 * * * *"
		]
	},
	"observability": {
		"enabled": true
	}
}
